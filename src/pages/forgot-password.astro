---
import Base from '../layouts/Base.astro';

export const prerender = false;
---

<Base title="Reset your password · fonthead.dev">
  <div style="background:var(--paper);min-height:100vh;display:flex;flex-direction:column;">
    <div style="flex:1;max-width:420px;width:100%;margin:64px auto;padding:0 24px;box-sizing:border-box;">
      <p class="fh-eyebrow">fonthead.dev · accounts</p>
      <h1 style="font-size:24px;font-weight:600;letter-spacing:-.02em;margin:12px 0 6px;">Reset your password</h1>
      <p style="font-size:13.5px;color:var(--ink-soft);margin:0 0 26px;line-height:1.5;">
        Enter your email and we will send a link to set a new password.
      </p>

      <form id="forgotform" style="display:flex;flex-direction:column;gap:12px;">
        <label for="email" class="fh-mono" style="font-size:11px;color:var(--ink-faint);letter-spacing:.06em;">EMAIL</label>
        <input id="email" name="email" type="email" class="fh-input" autocomplete="email" required placeholder="you@example.com" />

        <div style="margin-top:18px;">
          <button type="submit" id="send" class="fh-btn" style="width:100%;justify-content:center;">send reset link</button>
        </div>
        <p id="msg" role="status" aria-live="polite" class="fh-mono" style="font-size:11.5px;color:var(--ink-soft);min-height:16px;margin:8px 0 0;line-height:1.5;"></p>
        <p class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);margin:4px 0 0;">
          Remembered it? <a href="/sign-in" style="color:var(--ink);">Sign in</a>
        </p>
      </form>
    </div>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;"><a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a><a href="/terms" style="color:inherit;">terms</a><a href="/privacy" style="color:inherit;">privacy</a></div>
    </footer>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';

  const msg = document.getElementById('msg') as HTMLElement;
  const send = document.getElementById('send') as HTMLButtonElement;

  document.getElementById('forgotform')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    if (!email) {
      msg.style.color = 'var(--signal)';
      msg.textContent = 'Enter your email.';
      return;
    }
    msg.style.color = 'var(--ink-soft)';
    msg.textContent = 'sending…';
    send.disabled = true;
    // Reset goes through Better Auth's token-check endpoint, which then lands the
    // user on /reset-password with the token. The response is the same whether or
    // not the email is registered, so we never reveal which addresses have accounts.
    await authClient.requestPasswordReset({ email, redirectTo: '/reset-password' });
    msg.textContent = 'If that email has an account, the reset link is on its way. Check your inbox.';
    send.disabled = false;
  });
</script>
