---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---

<Base title="Not found · fonthead.dev" description="That page does not exist.">
  <main style="max-width:680px;margin:0 auto;padding:120px 24px;text-align:center;">
    <div class="fh-mono" style="font-size:13px;letter-spacing:.18em;color:var(--signal);text-transform:uppercase;">404</div>
    <h1 style="font-size:34px;font-weight:600;letter-spacing:-.02em;margin:16px 0 12px;">This page is not here</h1>
    <p class="fh-mono" style="font-size:13px;color:var(--ink-soft);line-height:1.7;margin:0 0 28px;">
      The page or font you are after does not exist, or it was taken down.
    </p>
    <a class="fh-btn" href="/">back to the library</a>
  </main>
</Base>
