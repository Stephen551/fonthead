---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { getFont, fontFaceCss, specClass, specStyle, familyOf, kb } from '../../lib/fonts';
import { createAuth } from '../../lib/auth';

export const prerender = false;

const { id } = Astro.params;
const env = Astro.locals.runtime.env;
const f = id ? await getFont(env.DB, id) : null;

if (!f) {
  return Astro.rewrite('/404');
}

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
const userId = session?.user.id ?? null;

// private fonts are visible only to their owner
if (f.visibility === 'private' && userId !== f.owner_id) {
  return Astro.rewrite('/404');
}

// the signed-in author looking at their own font gets a delete control
const isOwner = !!userId && userId === f.owner_id;

let voted = false;
let favorited = false;
if (userId) {
  voted = !!(await env.DB.prepare('SELECT 1 FROM votes WHERE user_id = ? AND font_id = ?').bind(userId, f.id).first());
  favorited = !!(await env.DB.prepare('SELECT 1 FROM favorites WHERE user_id = ? AND font_id = ?').bind(userId, f.id).first());
}

const m = f.meta;
const faceCss = fontFaceCss([f]);
const family = familyOf(f.id);
const fmt = m.treat === 'variable' ? 'variable' : 'static';
const published = (() => {
  const d = new Date(f.created_at.replace(' ', 'T') + 'Z');
  if (isNaN(d.getTime())) return f.created_at;
  const p = (n: number) => String(n).padStart(2, '0');
  return `${p(d.getUTCMonth() + 1)}·${p(d.getUTCDate())}·${d.getUTCFullYear()}`;
})();
const defaultSize = f.specimen_word.length > 7 ? 104 : 132;
const slug = f.name.toLowerCase().replace(/ /g, '-');

const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const lower = 'abcdefghijklmnopqrstuvwxyz';
const other = '0123456789&?!@#.,()$';
const specInline = specStyle(f.id, m);

// Per-page SEO: a font-specific description and a CreativeWork record. The name
// and maker are user-controlled, but Base escapes the JSON-LD before set:html.
const origin = Astro.url.origin;
const canonicalUrl = Astro.url.href;
// per-font social card if one was generated, else the generic site card
const ogImg = m.og ? `/cdn/og/${f.id}.png` : '/og.png';
const shareText = `${f.name} on fonthead.dev`;
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonicalUrl)}`;
// the maker's chosen license; older fonts predate the picker and read as OFL
const licenseKey = m.license ?? 'ofl';
const licenseLabel = licenseKey === 'cc0' ? 'CC0' : licenseKey === 'personal' ? 'personal use' : 'OFL';
const kind = m.badge === 'color' ? 'color font' : 'font';
const fontDescription = `${f.name}, a ${kind} by ${f.maker_handle} on fonthead.dev. Preview every glyph and download it, or trace your own from an alphabet sheet.`;
// Stand-in faces credit their original designer's full name (spaces and all) and
// have no /u/ page, so only real makers get a profile url; that handle is already
// slug-safe, encoded for belt and braces. A raw name would emit an invalid URL.
const makerPerson = m.standIn
  ? { '@type': 'Person', name: f.maker_handle }
  : { '@type': 'Person', name: f.maker_handle, url: `${origin}/u/${encodeURIComponent(f.maker_handle)}` };
const fontSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: f.name,
  url: canonicalUrl,
  creator: makerPerson,
  author: makerPerson,
  dateCreated: f.created_at,
  datePublished: f.created_at,
  genre: 'Typeface',
  ...(f.glyph_count ? { numberOfItems: f.glyph_count } : {}),
};
---

<Base
  title={`${f.name} · fonthead.dev`}
  description={fontDescription}
  ogImage={ogImg}
  schema={fontSchema}
  active="library"
>
  <style slot="head" is:inline set:html={faceCss}></style>

  <div style="background:var(--paper);min-height:100vh;">
    <!-- back + title row -->
    <div class="fh-pad" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:18px 0;border-bottom:1px solid var(--line);">
      <a href="/" class="fh-mono" style="font-size:12.5px;color:var(--ink-soft);text-decoration:none;display:inline-flex;gap:8px;align-items:center;">
        <span>&larr;</span> library / {slug}
      </a>
      <div style="display:flex;gap:9px;align-items:center;">
        <Badge kind={m.badge} />
        <Badge vis={f.visibility === 'private' ? 'private' : null} />
        <span class="fh-mono" style="font-size:11px;color:var(--ink-faint);">published {published}</span>
      </div>
    </div>

    <!-- type-into specimen -->
    <section class="fh-pad" style="padding:34px 0 24px;border-bottom:1px solid var(--line);">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:18px;">
        <div>
          <h1 style="font-size:26px;font-weight:600;margin:0;letter-spacing:-.02em;">{f.name}</h1>
          <div class="fh-mono" style="font-size:12px;color:var(--ink-soft);margin-top:6px;">
            by {f.maker_handle}
            {m.standIn && <span style="color:var(--ink-faint);">&nbsp;&nbsp;·&nbsp;&nbsp;open-license face, standing in</span>}
          </div>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
          <button class={`fh-fav${favorited ? ' on' : ''}`} data-fav data-font-id={f.id} aria-pressed={favorited} aria-label={`Favorite ${f.name}`} style="width:38px;height:38px;">
            <svg viewBox="0 0 24 24" style="width:17px;height:17px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
          <button class={`fh-vote${voted ? ' on' : ''}`} data-vote data-font-id={f.id} aria-pressed={voted} aria-label={`Upvote ${f.name}`}><span class="caret" aria-hidden="true"><svg viewBox="0 0 9 9"><path d="M1.5 5.5L4.5 2.5L7.5 5.5"/></svg></span><span class="fh-count" data-count>{f.votes_count.toLocaleString()}</span></button>
          <button data-share data-share-url={canonicalUrl} data-share-title={shareText} class="fh-btn fh-btn--ghost" style="font-size:12px;">share</button>
        </div>
      </div>

      <div style={`position:relative;min-height:${Math.round(defaultSize * 1.15)}px;display:flex;align-items:center;padding:6px 0;`}>
        <div
          id="specimen"
          contenteditable="true"
          spellcheck="false"
          role="textbox"
          aria-multiline="false"
          aria-label={`Type to preview ${f.name}`}
          transition:name={`spec-${f.id}`}
          class={specClass(m)}
          style={`${specInline};font-size:min(${defaultSize}px,12vw);line-height:1.08;width:100%;white-space:normal;overflow-wrap:anywhere;caret-color:var(--signal);`}
        >{f.specimen_word}</div>
      </div>

      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:18px;">
        <span class="fh-mono" style="font-size:11px;color:var(--ink-faint);letter-spacing:.06em;">SIZE</span>
        <input id="size" type="range" min="48" max="220" value={defaultSize} class="fh-range" style="flex:1;min-width:160px;max-width:420px;" aria-label="Specimen size" />
        <span id="sizeval" class="fh-mono" style="font-size:12px;color:var(--ink-soft);width:54px;">{defaultSize} px</span>
        <span style="flex:1;"></span>
        <span class="fh-mono" style="font-size:11px;color:var(--ink-faint);white-space:nowrap;">click the specimen to type</span>
      </div>
    </section>

    <!-- glyph set + metadata -->
    <div class="fh-fontpage-grid">
      <div class="fh-pad" style="padding:28px 0;border-right:1px solid var(--line);">
        <div class="fh-eyebrow" style="margin-bottom:18px;">Glyph set · {f.glyph_count ?? '–'} total</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(34px,1fr));gap:8px;">
          {(upper + lower + other).split('').map((c) => (
            <div style="aspect-ratio:1;display:grid;place-items:center;border:1px solid var(--line);border-radius:2px;background:var(--paper);">
              <span class={specClass(m)} style={`${specInline};font-size:30px;line-height:1;`}>{c}</span>
            </div>
          ))}
        </div>
      </div>

      <aside class="fh-pad" style="padding:28px 0;background:var(--paper-2);">
        <div class="fh-eyebrow" style="margin-bottom:8px;">Files</div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:24px;">
          {[
            { label: 'OTF', key: f.otf_key, size: f.otf_size, ext: 'otf' },
            { label: 'TTF', key: f.ttf_key, size: f.ttf_size, ext: 'ttf' },
            { label: 'WOFF2', key: f.woff2_key, size: f.woff2_size, ext: 'woff2' },
          ].map((file) =>
            file.key ? (
              <a class="fh-dl" href={`/cdn/${file.key}`} download={`${slug}.${file.ext}`} data-font-id={f.id}>
                <span class="fh-mono fmt">{file.label}</span><span class="fh-mono sz">{kb(file.size)}</span>
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M7 1.5v8M3.5 6L7 9.5L10.5 6M2 12.5h10"/></svg>
              </a>
            ) : (
              <div class="fh-dl" aria-disabled="true" title={m.standIn ? 'stand-in face: install the woff2, or make your own' : `${file.label} not available for this font`}>
                <span class="fh-mono fmt">{file.label}</span>
                <span class="fh-mono sz">{m.standIn ? 'from the maker' : m.badge === 'color' ? 'n/a for color' : '–'}</span>
              </div>
            ),
          )}
        </div>

        <div class="fh-eyebrow" style="margin-bottom:4px;">Details</div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">glyphs</span>
          <span class="fh-mono" style="font-size:12.5px;color:var(--ink);">{f.glyph_count ?? '–'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">format</span>
          <span class="fh-mono" style="font-size:12.5px;color:var(--ink);">{fmt}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">downloads</span>
          <span class="fh-mono" style="font-size:12.5px;color:var(--ink);">{f.downloads_count.toLocaleString()}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">license</span>
          <a class="fh-mono" href="/licenses" style="font-size:12.5px;color:var(--ink);text-align:right;text-decoration:underline;text-underline-offset:3px;">{licenseLabel}</a>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">visibility</span>
          <span class="fh-mono" style="font-size:12.5px;color:var(--ink);">{f.visibility}</span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
          <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">{m.builtWith ? 'maker' : 'designer'}</span>
          <span class="fh-mono" style="font-size:12px;color:var(--ink);text-align:right;">{m.designer}</span>
        </div>
        {m.builtWith && (
          <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);gap:16px;">
            <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">built with</span>
            <span class="fh-mono" style="font-size:12px;color:var(--ink);text-align:right;">{m.builtWith}</span>
          </div>
        )}

        {m.ofl && (
          <p class="fh-mono" style="font-size:10px;line-height:1.5;color:var(--ink-faint);margin:14px 0 0;">{m.ofl}</p>
        )}
      </aside>
    </div>

    <footer class="fh-pad" style="padding:22px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      {m.standIn ? (
        <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);">a stand-in face · the real makers arrive with the maker</div>
      ) : (
        <a href={`/u/${f.maker_handle}`} class="fh-mono" style="font-size:11px;color:var(--ink-faint);text-decoration:none;">more from @{f.maker_handle}&nbsp;&rarr;</a>
      )}
      <a href={tweetUrl} target="_blank" rel="noopener noreferrer" class="fh-mono" style="font-size:11px;color:var(--ink-faint);text-decoration:underline;text-underline-offset:3px;">share on X</a>
      {isOwner ? (
        <span style="display:inline-flex;gap:16px;align-items:center;">
          <button data-edit-font data-font-id={f.id} class="fh-mono" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--ink-faint);padding:0;text-decoration:underline;text-underline-offset:3px;">edit details</button>
          <button data-del-font data-font-id={f.id} class="fh-mono" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--signal);padding:0;text-decoration:underline;text-underline-offset:3px;">delete this font</button>
        </span>
      ) : (
        !m.standIn && (
          <button data-report data-report-target="font" data-report-id={f.id} class="fh-mono" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--ink-faint);padding:0;text-decoration:underline;text-underline-offset:3px;">report this font</button>
        )
      )}
      <a href="/support" class="fh-mono" style="font-size:11px;color:var(--ink-faint);text-decoration:underline;text-underline-offset:3px;">support</a>
    </footer>

    {/* owner-only edit dialog: opened from the footer's [data-edit-font] trigger.
        Hidden until then; app.ts manages focus, the license toggle, and save. */}
    {isOwner && (
      <div id="fh-edit" class="fh-tour" hidden role="dialog" aria-modal="true" aria-label="Edit this font" data-font-id={f.id}>
        <div class="fh-tour-card">
          <button id="fh-edit-x" type="button" class="fh-tour-x" aria-label="Close">&times;</button>
          <p class="fh-eyebrow">edit this font</p>
          <label class="fh-mono" for="fh-edit-name" style="display:block;font-size:11px;color:var(--ink-faint);letter-spacing:.04em;margin:12px 0 5px;">name</label>
          <input id="fh-edit-name" class="fh-input" maxlength="60" value={f.name} style="width:100%;" />
          <label class="fh-mono" for="fh-edit-specimen" style="display:block;font-size:11px;color:var(--ink-faint);letter-spacing:.04em;margin:12px 0 5px;">specimen word</label>
          <input id="fh-edit-specimen" class="fh-input" maxlength="40" value={f.specimen_word} style="width:100%;" />
          <span class="fh-mono" style="display:block;font-size:11px;color:var(--ink-faint);letter-spacing:.04em;margin:12px 0 5px;">license</span>
          <div role="group" aria-label="License" style="display:flex;border:1px solid var(--line-2);border-radius:2px;overflow:hidden;width:max-content;">
            {(['ofl', 'cc0', 'personal'] as const).map((v) => (
              <button
                type="button"
                data-license-opt={v}
                aria-pressed={licenseKey === v}
                class="fh-mono fh-edit-lic"
                style="font-size:12px;padding:9px 14px;border:none;cursor:pointer;"
              >{v === 'ofl' ? 'OFL' : v === 'cc0' ? 'CC0' : 'personal'}</button>
            ))}
          </div>
          <p class="fh-mono" style="font-size:10.5px;line-height:1.6;color:var(--ink-faint);margin:14px 0 0;">
            files keep the name they were built with<br />changing the specimen word resets the share card
          </p>
          <p id="fh-edit-msg" role="status" aria-live="polite" class="fh-mono" style="font-size:11.5px;color:var(--ink-soft);min-height:14px;margin:8px 0 0;"></p>
          <div class="fh-tour-actions" style="margin-top:12px;">
            <button id="fh-edit-save" type="button" class="fh-btn">save changes</button>
            <button id="fh-edit-cancel" type="button" class="fh-btn fh-btn--ghost">cancel</button>
          </div>
        </div>
      </div>
    )}
  </div>
</Base>

<style>
  .fh-edit-lic {
    background: var(--paper);
    color: var(--ink-soft);
    transition: all var(--dur) var(--ease);
  }
  .fh-edit-lic[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
