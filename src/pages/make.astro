---
import Base from '../layouts/Base.astro';
import Maker from '../components/Maker.tsx';
import { createAuth } from '../lib/auth';

export const prerender = false;

const auth = createAuth(Astro.locals.runtime.env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
const signedIn = !!session;

const V = '0.8.59';
// Anton (an R2 face) backs the one-click sample sheet so it traces crisply.
const faceCss = "@font-face{font-family:'Anton';src:url('/cdn/fonts/anton.woff2') format('woff2');font-display:swap;}";
---

<Base title="Make a font · fonthead.dev" active="make">
  <style slot="head" is:inline set:html={faceCss}></style>
  <!-- vendored font engine (client-side). Classic globals; the worker self-loads the rest. -->
  <script is:inline src={`/assets/vendor/opentype.min.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/potrace.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-builder.js?v=${V}`}></script>
  <script is:inline src={`/assets/tracer-core.js?v=${V}`}></script>
  <script is:inline src={`/assets/singleline-core.js?v=${V}`}></script>
  <!-- color path: builds COLR/CPAL on the main thread, so wawoff2 loads here too -->
  <script is:inline>
    window.Module = {};
    window.wawoff2Ready = new Promise(function (resolve, reject) {
      window.Module.onRuntimeInitialized = resolve;
      window.Module.onAbort = function (w) {
        reject(new Error('wawoff2 init failed: ' + w));
      };
    });
  </script>
  <script is:inline src={`/assets/vendor/wawoff2_compress.js?v=${V}`}></script>
  <script is:inline src={`/assets/color-core.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-tables.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-autokern.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-features.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-colr-cpal.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-colr-v1.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-color-build.js?v=${V}`}></script>
  <script is:inline src={`/assets/vendor/font-engine-formats.js?v=${V}`}></script>
  <!-- the engine's own validator: the gate that drops fonts that fail (mono + colour) -->
  <script is:inline src={`/assets/vendor/font-engine-validate.js?v=${V}`}></script>
  <script is:inline src={`/assets/color-orchestrator.js?v=${V}`}></script>

  <div style="background:var(--paper);min-height:100vh;">
    <!-- title + steps -->
    <div style="display:flex;align-items:flex-end;justify-content:space-between;padding:30px 40px 24px;border-bottom:1px solid var(--line);">
      <div>
        <h1 style="font-size:30px;font-weight:600;margin:0;letter-spacing:-.02em;">Make a font</h1>
        <p style="margin:8px 0 0;font-size:14.5px;color:var(--ink-soft);">Drop an alphabet sheet. We build a real, installable font in your browser.</p>
      </div>
      <div class="fh-mono" style="display:flex;gap:18px;font-size:12px;">
        <span style="color:var(--ink);"><b style="font-weight:700;">01</b> drop</span>
        <span style="color:var(--signal);"><b style="font-weight:700;">02</b> build</span>
        <span style="color:var(--ink-faint);"><b style="font-weight:700;">03</b> download</span>
      </div>
    </div>

    <Maker client:only="react" signedIn={signedIn} />

    <footer style="padding:20px 40px;border-top:1px solid var(--line);display:flex;justify-content:space-between;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);">builds otf · ttf · woff2 · color (COLR) · nothing leaves your browser</div>
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);">your font · your license</div>
    </footer>
  </div>
</Base>
