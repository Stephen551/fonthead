---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';

export const prerender = false;

// A ?next= path (set when a vote/favorite bounced a signed-out visitor here)
// returns them where they were. Only same-origin paths are honoured, never an
// absolute or protocol-relative URL, so it can't become an open redirect.
const nextParam = Astro.url.searchParams.get('next');
const safeNext = nextParam && /^\/(?![/\\])/.test(nextParam) ? nextParam : '/account';

// If already signed in, go straight on.
const env = Astro.locals.runtime.env;
const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (session) return Astro.redirect(safeNext);

// Google sign-in shows only when it is configured.
const googleEnabled = !!env.GOOGLE_CLIENT_ID;
---

<Base title="Sign in · fonthead.dev">
  <div style="background:var(--paper);min-height:100vh;display:flex;flex-direction:column;">
    <div style="flex:1;max-width:420px;width:100%;margin:64px auto;padding:0 24px;box-sizing:border-box;">
      <p class="fh-eyebrow">fonthead.dev · accounts</p>
      <h1 style="font-size:24px;font-weight:600;letter-spacing:-.02em;margin:12px 0 6px;">Sign in</h1>
      <p style="font-size:13.5px;color:var(--ink-soft);margin:0 0 26px;line-height:1.5;">
        Welcome back. Sign in to publish, vote, and keep your favorites.
      </p>

      <div id="linkhelp" role="region" aria-label="Connect Google" hidden style="border:1px solid var(--line);border-radius:2px;padding:14px 16px;margin:0 0 22px;background:rgba(0,0,0,.02);">
        <p style="font-size:13px;color:var(--ink-soft);margin:0 0 10px;line-height:1.5;">
          You already have an account with this email and a password. Confirm your email to connect Google, then try again. Enter your email below first.
        </p>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
          <button type="button" id="linkhelp-send" class="fh-btn fh-btn--ghost">send confirmation link</button>
          <span id="linkhelp-msg" role="status" aria-live="polite" class="fh-mono" style="font-size:11px;color:var(--ink-faint);"></span>
        </div>
      </div>

      {googleEnabled && (
        <>
          <button type="button" id="google-signin" class="fh-btn fh-btn--ghost" style="width:100%;justify-content:center;">continue with google</button>
          <div class="fh-mono" style="text-align:center;font-size:11px;color:var(--ink-faint);letter-spacing:.08em;margin:16px 0;">or</div>
        </>
      )}

      <form id="authform" style="display:flex;flex-direction:column;gap:12px;">
        <label for="email" class="fh-mono" style="font-size:11px;color:var(--ink-faint);letter-spacing:.06em;">EMAIL</label>
        <input id="email" name="email" type="email" class="fh-input" autocomplete="email" required placeholder="you@example.com" />

        <label for="password" class="fh-mono" style="font-size:11px;color:var(--ink-faint);letter-spacing:.06em;margin-top:6px;">PASSWORD</label>
        <input id="password" name="password" type="password" class="fh-input" autocomplete="current-password" required minlength="8" placeholder="your password" />
        <a href="/forgot-password" class="fh-mono" style="font-size:11px;color:var(--ink-faint);text-decoration:underline;text-underline-offset:3px;align-self:flex-start;">forgot password?</a>

        <div style="margin-top:18px;">
          <button type="submit" id="signin" class="fh-btn" style="width:100%;justify-content:center;">sign in</button>
        </div>
        <p id="msg" role="status" aria-live="polite" class="fh-mono" style="font-size:11.5px;color:var(--signal);min-height:16px;margin:8px 0 0;"></p>
        <p class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);margin:4px 0 0;">
          Need an account? <a href="/sign-up" style="color:var(--ink);">Create one</a>
        </p>
      </form>
    </div>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;"><a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a><a href="/terms" style="color:inherit;">terms</a><a href="/privacy" style="color:inherit;">privacy</a><a href="/support" style="color:inherit;">support</a></div>
    </footer>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const byId = (id: string) => document.getElementById(id);
  const msg = document.getElementById('msg') as HTMLElement;
  const setMsg = (t: string) => (msg.textContent = t);

  // A failed Google sign-in lands back here with ?error=. The common case is
  // account_not_linked: an existing password account on this email whose email
  // isn't confirmed, so Google can't be linked to it yet. Guide them to confirm.
  const errCode = new URLSearchParams(location.search).get('error');
  if (errCode === 'account_not_linked') {
    byId('linkhelp')?.removeAttribute('hidden');
  } else if (errCode) {
    setMsg('that sign-in did not go through. try again.');
  }

  const helpSend = byId('linkhelp-send') as HTMLButtonElement | null;
  helpSend?.addEventListener('click', async () => {
    const hmsg = byId('linkhelp-msg');
    const email = $('email').value.trim();
    if (!email) {
      if (hmsg) hmsg.textContent = 'enter your email below first.';
      return;
    }
    helpSend.disabled = true;
    if (hmsg) hmsg.textContent = 'sending…';
    const res = await authClient
      .sendVerificationEmail({ email, callbackURL: '/account?verified=1' })
      .catch(() => ({ error: true }));
    if (hmsg) {
      hmsg.textContent =
        res && 'error' in res && res.error
          ? 'could not send just now. try again.'
          : 'sent. confirm from your inbox, then use google again.';
    }
    helpSend.disabled = false;
  });

  async function signIn() {
    const email = $('email').value.trim();
    const password = $('password').value;
    if (!email || !password) return setMsg('email and password are required');
    setMsg('signing in…');

    const res = await authClient.signIn.email({ email, password });
    if (res.error) {
      setMsg(res.error.message || 'that did not work');
      return;
    }
    const n = new URLSearchParams(location.search).get('next');
    window.location.href = n && /^\/(?![/\\])/.test(n) ? n : '/account';
  }

  document.getElementById('authform')?.addEventListener('submit', (e) => {
    e.preventDefault();
    signIn();
  });

  // Google: hand off to the provider, returning to ?next= (or /account).
  document.getElementById('google-signin')?.addEventListener('click', () => {
    const n = new URLSearchParams(location.search).get('next');
    const callbackURL = n && /^\/(?![/\\])/.test(n) ? n : '/account';
    // errorCallbackURL brings a failed link (account_not_linked and friends) back
    // here with ?error=, instead of the default /error page that doesn't exist.
    authClient.signIn.social({ provider: 'google', callbackURL, errorCallbackURL: '/sign-in' });
  });
</script>
