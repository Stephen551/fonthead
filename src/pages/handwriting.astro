---
import Base from '../layouts/Base.astro';

export const prerender = false;

// The handwriting landing page: the one search intent fonthead wins outright.
// Other services charge for this behind an account; here it runs free, in the
// browser, and the handwriting never leaves the device. The steps render both
// as visible text and inside the HowTo JSON-LD, from the same source.
const steps = [
  {
    name: 'Print the grid',
    text: ['Download the blank alphabet grid and print it.', 'The gray guides are there to help you place each character. They disappear when the sheet is traced, so only your writing becomes part of the font.'],
  },
  {
    name: 'Write your alphabet',
    text: ['Fill each box with a dark pen.', 'Write the capitals, lowercase letters, digits, and punctuation inside their boxes so the maker can separate and trace each character.'],
  },
  {
    name: 'Photograph it',
    text: ['Take a clear photo of the sheet in good light, with the page as flat as possible.', 'You can also scan it. If you open the maker on your phone, you can use your camera directly.'],
  },
  {
    name: 'Make your handwriting font',
    text: ['Drop the image into the maker.', 'Fonthead traces the letters in your browser and assembles your handwriting into OTF, TTF, and WOFF2 font files.'],
  },
];

const faqs = [
  {
    q: 'Does my handwriting get uploaded anywhere?',
    a: 'No. Tracing and font assembly run in your browser. Your sheet and font stay on your device unless you choose to publish the font.',
  },
  {
    q: 'Is the handwriting font generator free?',
    a: 'Yes. You can make and download your handwriting font without an account. An account is only needed if you want to publish it to the public library.',
  },
  {
    q: 'Can I make a handwriting font from my phone?',
    a: 'Yes. Print the grid, fill it out by hand, then open the maker on your phone and photograph the completed sheet.',
  },
  {
    q: 'Who owns the font I make?',
    a: 'You do. It is your handwriting. If you publish the font, you choose the license other people receive.',
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Turn your handwriting into a font',
  description:
    'Turn your handwriting into a font in your browser. Print the grid, write your alphabet, photograph it, and make an installable OTF, TTF, or WOFF2 font.',
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text.join(' ') })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Handwriting to Font — Make a Font From Your Handwriting · fonthead.dev"
  description="Turn your handwriting into a font in your browser. Print the grid, write your alphabet, photograph it, and make an installable OTF, TTF, or WOFF2 font."
  schema={[howToSchema, faqSchema]}
  active="make"
>
  <div style="background:var(--paper);min-height:100vh;">
    <header class="fh-pad" style="padding:56px 0 34px;border-bottom:1px solid var(--line);">
      <p class="fh-eyebrow">fonthead.dev · handwriting</p>
      <h1 class="fh-mono" style="font-size:clamp(28px,5vw,42px);font-weight:700;letter-spacing:-.01em;margin:12px 0 10px;max-width:18ch;line-height:1.15;">
        Turn your handwriting into a font
      </h1>
      <p style="font-size:15.5px;color:var(--ink-soft);line-height:1.55;margin:0 0 22px;max-width:54ch;">
        Your handwriting can become a real, installable font.
      </p>
      <p style="font-size:15.5px;color:var(--ink-soft);line-height:1.55;margin:0 0 22px;max-width:54ch;">
        Print the alphabet grid, write your characters by hand, photograph the page, and drop it into the maker. Fonthead traces your writing in your browser and builds OTF, TTF, and WOFF2 files you can install or publish.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/grid.png" download="fonthead-grid.png" class="fh-btn">download the grid</a>
        <a href="/make" data-astro-reload class="fh-btn fh-btn--ghost">open the maker&nbsp;&nbsp;&rarr;</a>
      </div>
    </header>

    <div class="fh-pad" style="max-width:760px;padding:8px 0 10px;">
      {steps.map((s, i) => (
        <section style="padding:26px 0;border-bottom:1px solid var(--line);display:flex;gap:18px;">
          <div class="fh-mono" style="font-size:13px;color:var(--ink-faint);min-width:34px;padding-top:2px;">0{i + 1}</div>
          <div>
            <h2 style="font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0 0 8px;">{s.name}</h2>
            {s.text.map((p) => (
              <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0 0 10px;max-width:60ch;">{p}</p>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="fh-pad" style="max-width:760px;padding:18px 0 28px;">
      <h2 class="fh-eyebrow" style="margin-bottom:6px;">Questions</h2>
      {faqs.map((f) => (
        <section style="padding:22px 0;border-bottom:1px solid var(--line);">
          <h3 style="font-size:15px;font-weight:600;letter-spacing:-.01em;margin:0 0 7px;">{f.q}</h3>
          <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;max-width:62ch;">{f.a}</p>
        </section>
      ))}
      <div style="padding:30px 0 16px;">
        <a href="/make" data-astro-reload class="fh-btn">Make your handwriting font</a>
      </div>
    </div>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a>
        <a href="/faq" style="color:inherit;">faq</a>
        <a href="/licenses" style="color:inherit;">licenses</a>
        <a href="/support" style="color:inherit;">support</a>
      </div>
    </footer>
  </div>
</Base>
