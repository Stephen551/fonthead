---
import Base from '../layouts/Base.astro';
---

<Base title="Something broke · fonthead.dev" description="An unexpected error.">
  <div style="max-width:680px;margin:0 auto;padding:120px 24px;text-align:center;">
    <div class="fh-mono" style="font-size:13px;letter-spacing:.18em;color:var(--signal);text-transform:uppercase;">500</div>
    <h1 style="font-size:34px;font-weight:600;letter-spacing:-.02em;margin:16px 0 12px;">Something broke on our side</h1>
    <p class="fh-mono" style="font-size:13px;color:var(--ink-soft);line-height:1.7;margin:0 0 28px;">
      That is on us, not you. Try again in a moment, or head back to the library.
    </p>
    <a class="fh-btn" href="/">back to the library</a>
  </div>
</Base>
