---
import Base from '../layouts/Base.astro';

export const prerender = false;

// Plain-language terms of use. A draft for review, not legal advice.

const sections = [
  {
    h: 'What fonthead is',
    body: [
      'A community library and maker for fonts. You can trace an alphabet sheet into a real font in your browser, publish it, and browse and download what others make. Making and downloading are free.',
    ],
  },
  {
    h: 'Your account',
    body: [
      'You need an account to publish, vote, and keep favorites. Keep your sign-in details to yourself. You are responsible for what happens under your account.',
    ],
  },
  {
    h: 'What you publish',
    body: [
      'You keep ownership of the fonts you make. When you publish one, two things are true: you confirm you have the right to publish it, and you grant everyone who downloads it the license you picked for that font.',
      'Do not publish letters traced from a typeface you do not have the rights to. See the licenses page for what each license means.',
    ],
  },
  {
    h: 'Acceptable use',
    body: [
      'Keep it legal and decent. No content that infringes someone\'s rights, breaks the law, or targets people with hate or harassment, including through font names.',
      'We remove fonts and names that cross this line. Repeated or serious violations get the account banned, which makes it read-only.',
    ],
  },
  {
    h: 'Moderation',
    body: [
      'We can remove content and ban accounts to keep the library usable and lawful. We try to be fair, but the call is ours. If a name or font is being abused, anyone can report it from its page.',
    ],
  },
  {
    h: 'No warranty',
    body: [
      'fonthead and the fonts on it are provided as they are, with no guarantee. Fonts are made by the community, so check a font before you rely on it for anything that matters.',
      'We are not responsible for how a downloaded font is used or for problems it causes.',
    ],
  },
  {
    h: 'Changes',
    body: [
      'These terms can change as the site grows. If they change in a meaningful way, we will update this page. Continuing to use fonthead means you accept the current version.',
    ],
  },
];
---

<Base
  title="Terms of use · fonthead.dev"
  description="The basics of using fonthead.dev: what you agree to when you publish a font, acceptable use, and how moderation works."
  active="library"
>
  <div style="background:var(--paper);min-height:100vh;">
    <header class="fh-pad" style="padding:48px 0 28px;border-bottom:1px solid var(--line);">
      <p class="fh-eyebrow">fonthead.dev</p>
      <h1 class="fh-mono" style="font-size:34px;font-weight:700;letter-spacing:-.01em;margin:10px 0 6px;">Terms of use</h1>
      <p class="fh-mono" style="font-size:12px;color:var(--ink-faint);max-width:60ch;">What you agree to when you use fonthead and publish a font, and how moderation works. Plain language, not legal advice.</p>
    </header>

    <div class="fh-pad" style="max-width:760px;padding:8px 0 48px;">
      {sections.map((s) => (
        <section style="padding:26px 0;border-bottom:1px solid var(--line);">
          <h2 style="font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0 0 8px;">{s.h}</h2>
          {s.body.map((p) => (
            <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0 0 10px;max-width:62ch;">{p}</p>
          ))}
        </section>
      ))}

      <section style="padding:26px 0;">
        <h2 style="font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0 0 8px;">Reporting a problem</h2>
        <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;max-width:62ch;">
          Spotted a font or a name that breaks these terms? Use the report link on its page. We review reports and act on the ones that need it. You can delete your own account any time from your <a href="/account" style="color:var(--ink);">account page</a>.
        </p>
      </section>
    </div>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a>
        <a href="/licenses" style="color:inherit;">licenses</a>
        <a href="/privacy" style="color:inherit;">privacy</a>
      </div>
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);">made, not generated</div>
    </footer>
  </div>
</Base>
