---
import Base from '../layouts/Base.astro';
import FontCard from '../components/FontCard.astro';
import CyclingWordmark from '../components/CyclingWordmark.astro';
import { listPublicFonts, getFontsByIds, getUserInteractions, fontFaceCss, familyOf, pageInfo, PAGE_SIZE, type Sort, type HeroFace, type Font } from '../lib/fonts';
import { getFeaturedFontIds } from '../lib/featured';
import { createAuth } from '../lib/auth';

export const prerender = false;

const url = new URL(Astro.request.url);
const sort: Sort = url.searchParams.get('sort') === 'new' ? 'new' : 'popular';
const q = (url.searchParams.get('q') ?? '').trim();
const isSearch = q.length > 0;
const reqPage = Math.max(parseInt(url.searchParams.get('page') ?? '1', 10) || 1, 1);

const env = Astro.locals.runtime.env;
const { items: fonts, total } = await listPublicFonts(env.DB, sort, {
  q,
  limit: PAGE_SIZE,
  offset: (reqPage - 1) * PAGE_SIZE,
});

const info = pageInfo(total, reqPage);
const page = info.page;
const showHero = !isSearch && page === 1;

// The daily feature drives the hero: the featured set if present, else the
// starter set (the top of the popular wall). Fetched on its own so it stays
// stable as the wall paginates.
let heroFonts: Font[] = [];
let isFeatured = false;
if (showHero) {
  const featuredIds = await getFeaturedFontIds(env.DB);
  if (featuredIds.length) {
    heroFonts = await getFontsByIds(env.DB, featuredIds);
    isFeatured = heroFonts.length > 0;
  }
  if (!heroFonts.length) {
    heroFonts = (await listPublicFonts(env.DB, 'popular', { limit: 12 })).items;
  }
}

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
const inter = session
  ? await getUserInteractions(env.DB, session.user.id)
  : { voted: new Set<string>(), favorited: new Set<string>() };

// One @font-face per face in view: the wall page plus the hero set.
const faceFonts = [...new Map([...heroFonts, ...fonts].map((f) => [f.id, f])).values()];
const faceCss = fontFaceCss(faceFonts);
const heroFaces: HeroFace[] = heroFonts.map((f) => ({
  id: f.id,
  family: familyOf(f.id),
  name: f.meta.family || f.name,
  designer: f.meta.designer || f.maker_handle,
  treat: f.meta.treat,
  grad: f.meta.grad,
  flat: f.meta.flat,
  varset: f.meta.varset,
  italic: f.meta.italic,
}));

// Build a wall URL, overriding only the params given (drops page on filter changes).
function wallUrl(over: { sort?: Sort; q?: string; page?: number }) {
  const p = new URLSearchParams();
  const s = over.sort ?? sort;
  if (s === 'new') p.set('sort', 'new');
  const term = over.q ?? q;
  if (term) p.set('q', term);
  const pg = over.page ?? 1;
  if (pg > 1) p.set('page', String(pg));
  const qs = p.toString();
  return qs ? `/?${qs}` : '/';
}
---

<Base active="library" title={isSearch ? `${q} · fonthead.dev` : undefined}>
  <style slot="head" is:inline set:html={faceCss}></style>

  <div style="min-height:100vh;background:var(--paper);">
    <h1 class="sr-only">fonthead.dev — a community font library and maker</h1>
    {showHero && (
      <header style="padding:56px 40px 30px;border-bottom:1px solid var(--line);position:relative;">
        <div class="fh-eyebrow" style="position:absolute;top:24px;left:40px;">fonthead.dev</div>
        <div class="fh-eyebrow" style="position:absolute;top:24px;right:40px;color:var(--ink-soft);">featuring · {isFeatured ? "yesterday's most-liked" : 'the starter set'}</div>
        <CyclingWordmark faces={heroFaces} />
        <p style="text-align:center;max-width:560px;margin:22px auto 0;font-size:15.5px;line-height:1.5;color:var(--ink-soft);">
          Make a font from an alphabet sheet, then publish it here. Below is a starter set of
          open-license faces, standing in until makers publish their own.
        </p>
      </header>
    )}

    <!-- sort + search bar -->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:20px 40px;border-bottom:1px solid var(--line);">
      <div style="display:flex;gap:4px;">
        {(['popular', 'new'] as const).map((s) => (
          <a
            href={wallUrl({ sort: s, page: 1 })}
            class="fh-mono"
            style={`font-size:12.5px;letter-spacing:.02em;padding:7px 14px;border-radius:2px;text-decoration:none;border:1px solid ${sort === s ? 'var(--ink)' : 'var(--line-2)'};background:${sort === s ? 'var(--ink)' : 'var(--paper)'};color:${sort === s ? 'var(--paper)' : 'var(--ink-soft)'};transition:all var(--dur) var(--ease);`}
          >
            {s}
          </a>
        ))}
      </div>
      <form method="get" role="search" style="display:flex;align-items:center;gap:8px;">
        {sort === 'new' && <input type="hidden" name="sort" value="new" />}
        <input
          type="search"
          name="q"
          value={q}
          placeholder="search fonts or makers"
          aria-label="Search fonts by name or maker"
          class="fh-mono"
          style="font-size:12.5px;padding:7px 12px;border-radius:2px;border:1px solid var(--line-2);background:var(--paper);color:var(--ink);width:min(220px,42vw);"
        />
        <button type="submit" class="fh-mono" style="font-size:12.5px;letter-spacing:.02em;padding:7px 14px;border-radius:2px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);cursor:pointer;">search</button>
        {isSearch && <a href={wallUrl({ q: '', page: 1 })} class="fh-mono" style="font-size:11.5px;color:var(--ink-soft);text-decoration:none;">clear</a>}
      </form>
      <div class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);">
        {isSearch ? `${total} ${total === 1 ? 'match' : 'matches'} for "${q}"` : `${total} fonts`}
      </div>
    </div>

    <!-- the wall -->
    {fonts.length > 0 ? (
      <div style="padding:28px 40px 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:20px;">
        {fonts.map((f) => <FontCard font={f} voted={inter.voted.has(f.id)} favorited={inter.favorited.has(f.id)} />)}
      </div>
    ) : (
      <div class="fh-mono" style="padding:64px 40px;text-align:center;font-size:13px;color:var(--ink-soft);line-height:1.7;">
        <p style="margin:0 0 14px;">Nothing matches "{q}" yet.</p>
        <a href={wallUrl({ q: '', page: 1 })} class="fh-btn fh-btn--ghost">back to all fonts</a>
      </div>
    )}

    <!-- pagination -->
    {info.pages > 1 && (
      <nav aria-label="Wall pages" style="display:flex;align-items:center;justify-content:center;gap:18px;padding:34px 40px 0;">
        {info.hasPrev
          ? <a href={wallUrl({ page: page - 1 })} class="fh-btn fh-btn--ghost">&larr;&nbsp;&nbsp;prev</a>
          : <span class="fh-btn fh-btn--ghost" aria-disabled="true" style="opacity:.4;pointer-events:none;">&larr;&nbsp;&nbsp;prev</span>}
        <span class="fh-mono" style="font-size:11.5px;color:var(--ink-faint);letter-spacing:.04em;">page {page} of {info.pages}</span>
        {info.hasNext
          ? <a href={wallUrl({ page: page + 1 })} class="fh-btn fh-btn--ghost">next&nbsp;&nbsp;&rarr;</a>
          : <span class="fh-btn fh-btn--ghost" aria-disabled="true" style="opacity:.4;pointer-events:none;">next&nbsp;&nbsp;&rarr;</span>}
      </nav>
    )}

    <!-- footer -->
    <footer style="margin-top:40px;padding:26px 40px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);letter-spacing:.04em;">
        fonthead.dev · a community font library + maker
      </div>
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);">made, not generated</div>
    </footer>
  </div>
</Base>
