---
import Base from '../layouts/Base.astro';

export const prerender = false;

// Plain-language privacy summary. A draft for review, not legal advice.

const sections = [
  {
    h: 'What stays in your browser',
    body: [
      'The maker runs on your device. Tracing your alphabet sheet, building the font, and compressing it all happen in your browser. Your source image and the font you build do not leave your computer unless you choose to publish.',
      'Until you press publish, nothing is uploaded.',
    ],
  },
  {
    h: 'What we store',
    body: [
      'With an account, we keep your email, your display name, your handle, an avatar if you add one, and the fonts you publish (their files and details like the name and license). We also keep your votes and favorites so the site works.',
      'We do not collect more than we need to run the library.',
    ],
  },
  {
    h: 'Signing in',
    body: [
      'We use a session cookie to keep you signed in. If you sign in with Google, Google shares your email and name with us so we can create or link your account. We do not get your Google password, and we do not post anything to your Google account.',
    ],
  },
  {
    h: 'Hosting and analytics',
    body: [
      'The site runs on Cloudflare, which stores the data above on our behalf. We use a privacy-respecting page-view counter to see how many people visit. It does not follow you across other sites and does not build a profile of you.',
      'We do not run ad trackers, and we do not sell your data.',
    ],
  },
];
---

<Base
  title="Privacy · fonthead.dev"
  description="What stays on your device, what fonthead stores when you have an account, and how to get your data removed."
  active="library"
>
  <div style="background:var(--paper);min-height:100vh;">
    <header class="fh-pad" style="padding:48px 0 28px;border-bottom:1px solid var(--line);">
      <p class="fh-eyebrow">fonthead.dev</p>
      <h1 class="fh-mono" style="font-size:34px;font-weight:700;letter-spacing:-.01em;margin:10px 0 6px;">Privacy</h1>
      <p class="fh-mono" style="font-size:12px;color:var(--ink-faint);max-width:60ch;">What stays on your device, what we store when you have an account, and how to get your data removed. Plain language, not legal advice.</p>
    </header>

    <div class="fh-pad" style="max-width:760px;padding:8px 0 48px;">
      {sections.map((s) => (
        <section style="padding:26px 0;border-bottom:1px solid var(--line);">
          <h2 style="font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0 0 8px;">{s.h}</h2>
          {s.body.map((p) => (
            <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0 0 10px;max-width:62ch;">{p}</p>
          ))}
        </section>
      ))}

      <section style="padding:26px 0;">
        <h2 style="font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0 0 8px;">Deleting your account</h2>
        <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;max-width:62ch;">
          You can delete your account yourself from your <a href="/account" style="color:var(--ink);">account page</a>. It removes your account and everything tied to it: your profile, your published fonts, and your votes and favorites. It cannot be undone.
        </p>
      </section>
    </div>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a>
        <a href="/licenses" style="color:inherit;">licenses</a>
        <a href="/terms" style="color:inherit;">terms</a>
      </div>    </footer>
  </div>
</Base>
