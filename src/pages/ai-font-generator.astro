---
import Base from '../layouts/Base.astro';

export const prerender = false;

// The AI font generator landing page: the same AI-sheet path into the maker as
// /image-to-font, pitched at "ai font generator" searches. The copy is the
// reviewed copy book verbatim (Querywright strategy 19cf0667), so headings keep
// the copy's levels and no heading is restyled to uppercase: the live check
// matches title, description, headings and body text exactly and in order.
// The drawings are /image-to-font's step drawings (the maker's sheet presets
// and style chips, the STANDARD prompt's opening lines, the mono build stages);
// their labels are part of the drawings, not the copy.
const steps = [
  {
    fig: 'style',
    lead: 'Pick a style.',
    text: 'Start from a sheet style (standard, script, monoline, flat color or gradient color) and a look: geometric sans, slab serif, marker hand, art deco, pixel, or one you describe yourself.',
  },
  {
    fig: 'prompt',
    lead: 'Make the prompt yours.',
    text: 'Fonthead writes the prompt for you. Use it as is, edit it, or add your own style description.',
  },
  {
    fig: 'generate',
    lead: 'Generate the alphabet.',
    text: 'Paste the prompt into ChatGPT or Gemini and let it draw your alphabet sheet.',
  },
  {
    fig: 'drop',
    lead: 'Drop it into the <a href="/make" data-astro-reload>font maker</a>.',
    text: 'Fonthead traces each character in your browser and builds your font files.',
  },
] as const;

// Rendered as the visible questions and, word for word, as the FAQPage JSON-LD
// (a is the plain schema answer, html carries the visible link).
const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: 'Is this AI font generator free?',
    a: "Yes. Making, downloading and publishing fonts on Fonthead is free, and you don't need an account to make or download one. The prompt works with free ChatGPT and Gemini accounts.",
  },
  {
    q: 'Does Fonthead use its own AI?',
    a: 'No. ChatGPT or Gemini draws the alphabet sheet from the prompt Fonthead writes. Fonthead traces the sheet and builds the font in your browser.',
  },
  {
    q: 'What files do I get?',
    a: 'Regular fonts download as OTF, TTF and WOFF2. Color fonts download as COLR/CPAL OTF and WOFF2. They install like any other font.',
  },
  {
    q: 'Can I use any image?',
    a: "No. The maker needs a full alphabet sheet. A photo of a single word, logo or sign doesn't give it a full set of characters to build from.",
  },
  {
    q: 'Can Fonthead identify a font from a picture?',
    a: "No. Fonthead makes new fonts from alphabet sheets. It doesn't identify existing fonts.",
  },
  {
    q: 'Who chooses the license?',
    a: 'You do. When you publish a font to the library, you choose the license other people receive. Read more about font licensing.',
    html: 'You do. When you publish a font to the library, you choose the license other people receive. Read more about <a href="/licenses">font licensing</a>.',
  },
];

const title = 'Free AI Font Generator: Make a Real Font · fonthead.dev';
const description =
  'Make a font with AI for free. Generate an alphabet in ChatGPT or Gemini from our prompt, then download a real OTF, TTF or WOFF2 font. No account needed.';

const origin = Astro.url.origin;
const canonical = `${origin}/ai-font-generator`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: 'AI font generator', item: canonical },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// ---- drawing data (as on /image-to-font) ----

// The STANDARD prompt's seven rows, as the generated sheet lays them out.
const sheetRows = ['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ', 'abcdefghijklm', 'nopqrstuvwxyz', '0123456789', '!?@#$%^&*()-_+=[]', '{};:\'",.<>/\\|'].map((r) => [...r]);

// The maker's sheet presets and standard-style chips, in the maker's order.
const sheetStyles = ['standard', 'script', 'monoline', 'flat color', 'gradient color'];

// A 7×7 bitmap "A" for the pixel look.
const pixelA = ['..XXX..', '.XX.XX.', 'XX...XX', 'XX...XX', 'XXXXXXX', 'XX...XX', 'XX...XX'].flatMap((row, y) =>
  [...row].flatMap((c, x) => (c === 'X' ? [{ x: 15 + x * 10, y: 15 + y * 10 }] : [])),
);

// The mono build stages, verbatim from the maker's readout.
const stages = [
  ['binarize', 'threshold · otsu adaptive'],
  ['slice', 'rows · cells · baseline'],
  ['trace', 'contours · vectorize'],
  ['build', 'opentype · pack otf ttf woff2'],
];

// The traced "a" in the hero: a geometric single-storey a, as a tracer emits
// it. One outer contour (stem + bowl, the bowl meeting the stem at x=78), one
// counter, on-curve nodes at the extrema and bezier handles on the bowl.
const K = 17.7; // 0.5523 × r32, the cubic circle handle length
const outerNodes = [
  [78, 36], [92, 36], [92, 100], [78, 100], [78, 89.2], [54, 100], [22, 68], [54, 36], [78, 46.8],
  [54, 50], [72, 68], [54, 86], [36, 68],
];
const handles = [
  [54 - K, 100, 54 + K, 100],
  [22, 68 - K, 22, 68 + K],
  [54 - K, 36, 54 + K, 36],
];
---

<Base title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, faqSchema]} active="make">
  <div style="background:var(--paper);min-height:100vh;">
    <!-- a section, not a header: the introduction stays in the extractable body -->
    <section class="fh-pad aig-hero">
      <div>
        <h1 class="fh-mono" style="font-size:clamp(28px,5vw,42px);font-weight:700;letter-spacing:-.01em;margin:0 0 14px;max-width:18ch;line-height:1.15;">
          A free AI font generator that makes real fonts
        </h1>
        <p class="aig-lead">
          If you want a picture of fancy text, there are plenty of tools for that. If you want a font you can install and type with, start here. Describe a style, let ChatGPT or Gemini draw the alphabet, and Fonthead turns that sheet into OTF, TTF and WOFF2 files right in your browser. It's free, and you don't need an account.
        </p>
        <a href="/make" data-astro-reload class="fh-btn">Make your AI font</a>
      </div>

      <!-- the whole idea in one drawing: an alphabet image, one traced glyph, the font files -->
      <figure class="aig-flow" role="img" aria-label="An alphabet image is traced into vector outlines and built into OTF, TTF and WOFF2 font files.">
        <div class="aig-flow-cell">
          <div class="aig-sheet aig-sheet--thumb">
            {sheetRows.slice(0, 5).map((row) => (
              <div class="aig-sheet-row">{row.map((c) => <span>{c}</span>)}</div>
            ))}
          </div>
          <span class="aig-flow-label">alphabet.png</span>
        </div>
        <span class="aig-arrow"><span>trace</span></span>
        <div class="aig-flow-cell">
          <svg class="aig-glyph" viewBox="0 0 120 120" aria-hidden="true">
            <path
              class="aig-glyph-fill"
              fill-rule="evenodd"
              d="M78 36 H92 V100 H78 V89.2 A32 32 0 1 1 78 46.8 Z M54 50 A18 18 0 1 0 54 86 A18 18 0 1 0 54 50 Z"
            />
            {handles.map(([x1, y1, x2, y2]) => (
              <g class="aig-handle">
                <line x1={x1} y1={y1} x2={x2} y2={y2} />
                <circle cx={x1} cy={y1} r="2.2" />
                <circle cx={x2} cy={y2} r="2.2" />
              </g>
            ))}
            {outerNodes.map(([x, y]) => <rect class="aig-node" x={x - 2.6} y={y - 2.6} width="5.2" height="5.2" />)}
          </svg>
          <span class="aig-flow-label">traced outline</span>
        </div>
        <span class="aig-arrow"><span>build</span></span>
        <div class="aig-flow-cell">
          <div class="aig-files aig-files--stack">
            <span class="aig-file">.otf</span>
            <span class="aig-file">.ttf</span>
            <span class="aig-file">.woff2</span>
          </div>
          <span class="aig-flow-label">installable font</span>
        </div>
      </figure>
    </section>

    <section class="fh-pad aig-how">
      <h2 class="aig-h2">How it works</h2>
      <ol class="aig-steps">
        {steps.map((s) => (
          <li class="aig-step">
            <p class="aig-step-copy"><strong set:html={s.lead} /> {s.text}</p>

            {s.fig === 'style' && (
              <figure class="aig-fig" role="img" aria-label="The maker's sheet styles, with standard selected, and six starting looks for the letter A.">
                <figcaption class="aig-cap">choose a sheet style</figcaption>
                <div class="aig-chips">
                  {sheetStyles.map((label, j) => (
                    <span class:list={['aig-chip', { 'is-on': j === 0 }]}>{label}</span>
                  ))}
                </div>
                <div class="aig-looks">
                  <div class="aig-look">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                      <path d="M20 88 L50 14 L80 88 M31 63 H69" fill="none" stroke="currentColor" stroke-width="11" stroke-linejoin="miter" />
                    </svg>
                    <span>geometric sans</span>
                  </div>
                  <div class="aig-look">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                      <path d="M24 84 L50 16 L76 84 M34 61 H66" fill="none" stroke="currentColor" stroke-width="12" stroke-linejoin="bevel" />
                      <path d="M10 86 H40 M60 86 H90" fill="none" stroke="currentColor" stroke-width="7" />
                    </svg>
                    <span>slab serif</span>
                  </div>
                  <div class="aig-look">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                      <path d="M22 85 Q33 52 48 16 Q64 50 79 86 M33 61 Q51 56 70 63" fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>marker hand</span>
                  </div>
                  <div class="aig-look">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                      <path d="M37 90 L50 10" fill="none" stroke="currentColor" stroke-width="3" />
                      <path d="M50 10 L64 90" fill="none" stroke="currentColor" stroke-width="12" />
                      <path d="M41 70 H61 M40 75 H62" fill="none" stroke="currentColor" stroke-width="2" />
                      <path d="M31 90 H44 M57 90 H70" fill="none" stroke="currentColor" stroke-width="3" />
                    </svg>
                    <span>art deco</span>
                  </div>
                  <div class="aig-look">
                    <svg viewBox="0 0 100 100" shape-rendering="crispEdges" aria-hidden="true">
                      {pixelA.map((p) => <rect x={p.x} y={p.y} width="10" height="10" fill="currentColor" />)}
                    </svg>
                    <span>pixel</span>
                  </div>
                  <div class="aig-look aig-look--own">
                    <span class="aig-own-mark">+</span>
                    <span>your own</span>
                  </div>
                </div>
              </figure>
            )}

            {s.fig === 'prompt' && (
              <figure class="aig-fig" role="img" aria-label="The prompt Fonthead writes, with your style description filled into it.">
                <figcaption class="aig-cap">the prompt, written for you</figcaption>
                <div class="aig-field">
                  <span class="aig-field-label">YOUR STYLE</span>
                  <span class="aig-input">bold geometric sans-serif<span class="aig-caret" /></span>
                </div>
<pre class="aig-prompt">Hand-drawn alphabet sheet, 7 rows on white paper:
Row 1: capitals A B C D E F G H I J K L M
Row 2: capitals N O P Q R S T U V W X Y Z
<span class="aig-dim">…</span>
Requirements:
- Pure BLACK ink on white background
- Consistent letterform style throughout <mark>(bold geometric sans-serif)</mark>
- Wide horizontal spacing between letters
<span class="aig-dim">…</span></pre>
                <span class="aig-fakebtn">Copy the prompt</span>
              </figure>
            )}

            {s.fig === 'generate' && (
              <figure class="aig-fig" role="img" aria-label="The prompt pasted into ChatGPT or Gemini, which returns a seven-row alphabet sheet.">
                <figcaption class="aig-cap">chatgpt or gemini</figcaption>
                <div class="aig-chat">
                  <p class="aig-bubble">Hand-drawn alphabet sheet, 7 rows on white paper: Row 1: capitals A B C D E F G H I J K L M …</p>
                  <div class="aig-sheet">
                    {sheetRows.map((row) => (
                      <div class="aig-sheet-row">{row.map((c) => <span>{c}</span>)}</div>
                    ))}
                  </div>
                </div>
              </figure>
            )}

            {s.fig === 'drop' && (
              <figure class="aig-fig" role="img" aria-label="The alphabet sheet dropped into the maker, which binarizes, slices, traces and builds it into OTF, TTF, WOFF2 and color font files.">
                <figcaption class="aig-cap">drop · build · download</figcaption>
                <div class="aig-drop">
                  <div class="aig-sheet aig-sheet--drop">
                    {sheetRows.slice(0, 5).map((row) => (
                      <div class="aig-sheet-row">{row.map((c) => <span>{c}</span>)}</div>
                    ))}
                  </div>
                  <span class="aig-drop-label">drop an alphabet sheet</span>
                </div>
                <div class="aig-term">
                  <span class="aig-term-head">build · fonthead maker</span>
                  {stages.map(([name, desc]) => (
                    <div class="aig-term-row">
                      <span class="aig-term-name">{name}</span>
                      <span class="aig-term-desc">{desc}</span>
                      <span class="aig-term-tick">✓</span>
                    </div>
                  ))}
                </div>
                <div class="aig-files">
                  <span class="aig-file">otf</span>
                  <span class="aig-file">ttf</span>
                  <span class="aig-file">woff2</span>
                  <span class="aig-file aig-file--color"><b>Aa</b> color (COLR)</span>
                </div>
              </figure>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="fh-pad aig-row">
      <h2 class="aig-h2">What you get</h2>
      <ul class="aig-list">
        <li><strong>Real font files.</strong> Regular fonts download as OTF, TTF and WOFF2. Color fonts download as COLR/CPAL OTF and WOFF2.</li>
        <li><strong>Fonts that install anywhere.</strong> Each font is validated the way Windows validates fonts, so the files open and install on Windows, macOS and Linux.</li>
        <li><strong>Your files stay with you.</strong> Tracing and building happen in your browser. A font only leaves your device if you choose to publish it.</li>
      </ul>
    </section>

    <section class="fh-pad aig-row">
      <h2 class="aig-h2">Free from start to finish</h2>
      <p class="aig-body">
        Making, downloading and publishing fonts on Fonthead is free, and you don't need an account to make or download one. The prompt works with free ChatGPT and Gemini accounts, so the whole process costs nothing.
      </p>
    </section>

    <section class="fh-pad aig-row">
      <h2 class="aig-h2">Where the AI comes in</h2>
      <p class="aig-body">
        Fonthead doesn't draw your letters with its own AI. The drawing happens in ChatGPT or Gemini, from the prompt Fonthead writes for you. Fonthead does the part an image generator doesn't: it traces every letter and builds a font file you can install. Think of it as an AI font maker in two parts: the AI draws, Fonthead builds. That split lets you steer the style in plain words and still end up with a real font.
      </p>
    </section>

    <section class="fh-pad aig-row">
      <h2 class="aig-h2">Tips for a cleaner AI-generated font</h2>
      <ul class="aig-list">
        <li><strong>Keep the prompt's rules.</strong> It asks for black ink on a white background, one consistent style and wide spacing between letters. Those rules make each letter easier to trace.</li>
        <li><strong>Describe the style, not the layout.</strong> Add words like "bold," "rounded" or "brush" to the style. Leave the rows and spacing the prompt sets up.</li>
        <li><strong>Not happy with a letter?</strong> Generate a new sheet and try again. It costs nothing.</li>
      </ul>
    </section>

    <section class="fh-pad aig-row">
      <h2 class="aig-h2">Other ways to make a font</h2>
      <ul class="aig-list">
        <li>Already have an alphabet image? See <a href="/image-to-font">image to font</a>.</li>
        <li>Prefer pen and paper? <a href="/handwriting">Turn your handwriting into a font</a>.</li>
      </ul>
    </section>

    <section class="fh-pad aig-faq">
      <h2 class="aig-h2" style="margin-bottom:6px;">Common questions</h2>
      {faqs.map((f) => (
        <div class="aig-qa">
          <p class="aig-q"><strong>{f.q}</strong></p>
          {f.html ? <p class="aig-answer" set:html={f.html} /> : <p class="aig-answer">{f.a}</p>}
        </div>
      ))}
      <div style="padding:30px 0 16px;">
        <a href="/make" data-astro-reload class="fh-btn">Make your AI font</a>
      </div>
    </section>

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a>
        <a href="/image-to-font" style="color:inherit;">image to font</a>
        <a href="/handwriting" style="color:inherit;">handwriting</a>
        <a href="/faq" style="color:inherit;">faq</a>
        <a href="/licenses" style="color:inherit;">licenses</a>
        <a href="/support" style="color:inherit;">support</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* inline prose links: the site's quiet underline */
  .aig-lead a,
  .aig-list a,
  .aig-step-copy :global(a),
  .aig-answer :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- hero: copy left, the one-drawing summary right ---- */
  .aig-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: 32px 48px;
    align-items: center;
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .aig-lead {
    font-size: 15.5px;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0 0 24px;
    max-width: 54ch;
  }

  .aig-flow {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 22px 18px 18px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 3px;
  }
  .aig-flow-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .aig-flow-label {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-faint);
    letter-spacing: .02em;
    white-space: nowrap;
  }
  .aig-arrow {
    position: relative;
    width: 34px;
    height: 1px;
    background: var(--line-3);
    margin-bottom: 22px;
  }
  .aig-arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3px;
    border: 3.5px solid transparent;
    border-left: 5px solid var(--line-3);
    border-right: 0;
  }
  .aig-arrow span {
    position: absolute;
    left: 50%;
    bottom: 6px;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
  }
  .aig-glyph {
    width: 100%;
    max-width: 118px;
    aspect-ratio: 1;
    display: block;
  }
  .aig-glyph-fill {
    fill: var(--paper-3);
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .aig-handle line { stroke: var(--line-3); stroke-width: 1; }
  .aig-handle circle { fill: var(--paper); stroke: var(--ink-faint); stroke-width: 1; }
  .aig-node { fill: var(--paper); stroke: var(--ink); stroke-width: 1.2; }

  /* ---- the alphabet sheet: paper keeps its light identity in both themes,
     like the maker's sheet canvases ---- */
  .aig-sheet {
    background: #fff;
    color: #15140f;
    border: 1px solid #ddd9cf;
    border-radius: 2px;
    box-shadow: 0 1px 0 rgba(21, 20, 15, .04), 0 6px 18px rgba(21, 20, 15, .07);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
  }
  .aig-sheet-row {
    display: flex;
    justify-content: space-between;
  }
  .aig-sheet-row span { flex: none; text-align: center; min-width: .55em; }
  .aig-sheet--thumb {
    width: 100%;
    max-width: 118px;
    aspect-ratio: 1;
    justify-content: center;
    padding: 8px 9px;
    gap: 5px;
    font-size: 6.5px;
  }
  .aig-sheet--drop {
    width: 46%;
    max-width: 150px;
    padding: 9px 10px;
    gap: 5px;
    font-size: 7px;
    transform: rotate(-3deg);
  }

  /* ---- section headings and the text rows: heading left, copy right ---- */
  .aig-h2 { font-size: 16px; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; margin: 0; }
  .aig-row {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 12px 40px;
    align-items: start;
    max-width: 1080px;
    padding: 34px 0;
    border-bottom: 1px solid var(--line);
  }
  .aig-body { font-size: 14px; color: var(--ink-soft); line-height: 1.6; margin: 0; max-width: 62ch; }
  .aig-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 62ch;
  }
  .aig-list li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  /* the bullet is an on-curve node, as on the traced outline */
  .aig-list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: .62em;
    width: 5px;
    height: 5px;
    background: var(--paper);
    border: 1.2px solid var(--ink);
  }
  .aig-list strong,
  .aig-step-copy strong,
  .aig-q strong { font-weight: 600; color: var(--ink); }

  /* ---- steps: number · copy · drawing ---- */
  .aig-how { max-width: 1080px; padding: 34px 0 10px; }
  .aig-steps { list-style: none; margin: 0; padding: 0; counter-reset: aig-step; }
  .aig-step {
    counter-increment: aig-step;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) minmax(0, 420px);
    gap: 18px 32px;
    align-items: start;
    padding: 34px 0;
    border-bottom: 1px solid var(--line);
  }
  .aig-step:last-child { border-bottom: 0; }
  /* the step number, drawn from the list's counter so the copy stays the copy */
  .aig-step::before {
    content: counter(aig-step, decimal-leading-zero);
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 13px;
