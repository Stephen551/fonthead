---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';
import { isAdminEmail } from '../lib/util';
import { parseBugContext, formatBugContext } from '../lib/bugreport';

export const prerender = false;

// Admin-only. Anyone who is not on the ADMIN_EMAILS allowlist gets a 404, so the
// route's existence is not even advertised.
const env = Astro.locals.runtime.env;
const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session || !isAdminEmail(env.ADMIN_EMAILS, session.user.email)) {
  return Astro.rewrite('/404');
}

type ReportRow = {
  id: string;
  target_type: string;
  font_id: string | null;
  reported_user_id: string | null;
  reason: string;
  created_at: string;
  font_name: string | null;
  maker_handle: string | null;
  maker_banned: number | null;
  reporter_handle: string | null;
  reporter_email: string | null;
};
const { results: reports } = await env.DB.prepare(
  `SELECT r.id, r.target_type, r.font_id, r.reported_user_id, r.reason, r.created_at,
          f.name AS font_name,
          mu.handle AS maker_handle, mu.banned AS maker_banned,
          ru.handle AS reporter_handle, ru.email AS reporter_email
     FROM reports r
     LEFT JOIN fonts f ON f.id = r.font_id
     LEFT JOIN "user" mu ON mu.id = r.reported_user_id
     LEFT JOIN "user" ru ON ru.id = r.reporter_id
    WHERE r.status = 'open'
    ORDER BY r.created_at DESC
    LIMIT 200`,
).all<ReportRow>();

// Bug reports from the maker (ADR 0060), newest first, with their context
// formatted the same way the email shows it.
type BugRow = {
  id: string;
  message: string;
  reply_email: string | null;
  context: string;
  sheet_key: string | null;
  created_at: string;
  reporter_handle: string | null;
};
// Deploys do not apply migrations, so until 0007 runs the table is missing; the
// rest of the admin page must keep working and say what is needed.
let bugRows: BugRow[] = [];
let bugsMissing = false;
try {
  ({ results: bugRows } = await env.DB.prepare(
    `SELECT b.id, b.message, b.reply_email, b.context, b.sheet_key, b.created_at, u.handle AS reporter_handle
       FROM bug_reports b
       LEFT JOIN "user" u ON u.id = b.user_id
      WHERE b.status = 'open'
      ORDER BY b.created_at DESC
      LIMIT 200`,
  ).all<BugRow>());
} catch {
  bugsMissing = true;
}
const bugs = (bugRows ?? []).map((b) => ({ ...b, contextText: formatBugContext(parseBugContext(b.context)) }));

type MakerReviewRow = {
  id: string;
  rating: number;
  message: string;
  allow_public: number;
  permission_text: string | null;
  created_at: string;
};
const { results: makerReviews } = await env.DB.prepare(
  'SELECT id, rating, message, allow_public, permission_text, created_at FROM maker_reviews ORDER BY created_at DESC LIMIT 100',
).all<MakerReviewRow>();

type UserRow = {
  id: string;
  name: string;
  email: string;
  handle: string | null;
  createdAt: string;
  banned: number;
  font_count: number;
  votes: number;
};
const { results: users } = await env.DB.prepare(
  `SELECT u.id, u.name, u.email, u.handle, u.createdAt, u.banned,
          (SELECT COUNT(*) FROM fonts WHERE owner_id = u.id) AS font_count,
          (SELECT COALESCE(SUM(votes_count), 0) FROM fonts WHERE owner_id = u.id) AS votes
     FROM "user" u
    ORDER BY u.createdAt DESC
    LIMIT 500`,
).all<UserRow>();

// The maker funnel, last 14 days: day rows pivoted across the event columns,
// plus 14-day meta breakdowns for the events that carry one.
type FunnelRow = { day: string; event: string; meta: string; count: number };
const { results: funnelRows } = await env.DB.prepare(
  "SELECT day, event, meta, count FROM funnel WHERE day >= date('now', '-13 days') ORDER BY day DESC",
).all<FunnelRow>();
const FUNNEL_EVENTS = ['make_view', 'sheet_drop', 'sample_try', 'grid_print', 'build_ok', 'build_fail', 'download', 'publish_ok'] as const;
const funnelDays = new Map<string, Record<string, number>>();
const funnelMeta = new Map<string, number>();
for (const r of funnelRows ?? []) {
  if (!funnelDays.has(r.day)) funnelDays.set(r.day, {});
  const d = funnelDays.get(r.day)!;
  d[r.event] = (d[r.event] ?? 0) + r.count;
  if (r.meta) {
    const k = `${r.event} · ${r.meta}`;
    funnelMeta.set(k, (funnelMeta.get(k) ?? 0) + r.count);
  }
}
const funnelMetaSorted = [...funnelMeta.entries()].sort((a, b) => b[1] - a[1]);

const day = (s: string | null) => (s ? s.slice(0, 10) : '–');
const th = 'text-align:left;font-size:10.5px;letter-spacing:.06em;color:var(--ink-faint);text-transform:uppercase;padding:0 12px 8px 0;font-weight:500;';
const td = 'font-size:12.5px;color:var(--ink);padding:9px 12px 9px 0;border-top:1px solid var(--line);vertical-align:top;';
---

<Base title="Admin · fonthead.dev">
  <div style="background:var(--paper);min-height:100vh;">
    <header class="fh-pad" style="padding:40px 0 22px;border-bottom:1px solid var(--line);">
      <p class="fh-eyebrow">fonthead.dev · admin</p>
      <h1 class="fh-mono" style="font-size:30px;font-weight:700;letter-spacing:-.01em;margin:10px 0 0;">Moderation</h1>
      <p id="admin-msg" role="status" aria-live="polite" class="fh-mono" style="font-size:12px;color:var(--ink-soft);min-height:16px;margin:8px 0 0;"></p>
    </header>

    <section class="fh-pad" style="padding:28px 0;border-bottom:1px solid var(--line);">
      <div class="fh-eyebrow" style="margin-bottom:14px;">Maker funnel · last 14 days</div>
      {funnelDays.size > 0 ? (
        <div style="overflow-x:auto;">
          <table class="fh-mono" style="border-collapse:collapse;min-width:760px;">
            <thead>
              <tr>
                <th style={th}>day</th>
                {FUNNEL_EVENTS.map((e) => (
                  <th style={th}>{e.replace('_', ' ')}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {[...funnelDays.entries()].map(([d, counts]) => (
                <tr>
                  <td style={td}>{d}</td>
                  {FUNNEL_EVENTS.map((e) => (
                    <td style={td + (counts[e] ? '' : 'color:var(--ink-faint);')}>{counts[e] ?? 0}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          {funnelMetaSorted.length > 0 && (
            <p class="fh-mono" style="font-size:11px;color:var(--ink-soft);margin:12px 0 0;line-height:1.7;max-width:90ch;">
              {funnelMetaSorted.map(([k, n]) => `${k} ${n}`).join('  ·  ')}
            </p>
          )}
        </div>
      ) : (
        <p class="fh-mono" style="font-size:12px;color:var(--ink-faint);">no events yet</p>
      )}
    </section>

    <section class="fh-pad" style="padding:28px 0;border-bottom:1px solid var(--line);">
      <div class="fh-eyebrow" style="margin-bottom:14px;">Maker reviews · latest {makerReviews?.length ?? 0}</div>
      <p style="font-size:12px;color:var(--ink-soft);margin:0 0 14px;line-height:1.5;">Reviews are kept here for the team. Permission allows anonymous display on Fonthead; it does not publish a review automatically.</p>
      {makerReviews?.length ? (
        <div style="display:grid;gap:12px;">
          {makerReviews.map(review => (
            <article data-review-id={review.id} style="border:1px solid var(--line);border-radius:3px;padding:14px 16px;min-width:0;">
              <p class="fh-mono" style="font-size:12px;margin:0 0 8px;color:var(--ink);">{review.rating}/5 · {day(review.created_at)}</p>
              <p style="font-size:13px;margin:0 0 10px;white-space:pre-wrap;overflow-wrap:anywhere;">{review.message || '(rating only)'}</p>
              <p class="fh-mono" style="font-size:11.5px;margin:0;color:var(--ink-soft);">{review.allow_public ? 'Public display permitted · anonymous' : 'Private feedback · do not publish'}</p>
              {review.allow_public && <p style="font-size:11px;color:var(--ink-faint);margin:6px 0 0;">Permission given: {review.permission_text}</p>}
            </article>
          ))}
        </div>
      ) : <p class="fh-mono" style="font-size:12px;color:var(--ink-faint);">No maker reviews yet.</p>}
    </section>

    <section class="fh-pad" style="padding:28px 0;border-bottom:1px solid var(--line);">
      <div class="fh-eyebrow" style="margin-bottom:14px;">Bug reports · {bugs.length} open</div>
      {bugs.length > 0 ? (
        <div style="display:flex;flex-direction:column;gap:14px;">
          {bugs.map((b) => (
            <div data-bug-row style="border:1px solid var(--line);border-radius:3px;padding:14px 16px;display:flex;gap:16px;flex-wrap:wrap;">
              {b.sheet_key && (
                <a href={`/cdn/${b.sheet_key}`} target="_blank" rel="noopener" title="open the full sheet">
                  <img src={`/cdn/${b.sheet_key}`} alt="attached sheet" loading="lazy" style="width:180px;max-height:180px;object-fit:contain;border:1px solid var(--line);background:#fff;" />
                </a>
              )}
              <div style="flex:1;min-width:260px;">
                <p class="fh-mono" style="font-size:11px;color:var(--ink-faint);margin:0 0 6px;">
                  {day(b.created_at)} · {b.reporter_handle ? `@${b.reporter_handle}` : 'anonymous'}
                  {b.reply_email ? ` · reply to ${b.reply_email}` : ''}
                </p>
                <p style="font-size:13px;color:var(--ink);margin:0 0 10px;white-space:pre-wrap;">{b.message || '(no note)'}</p>
                <pre class="fh-mono" style="font-size:11px;color:var(--ink-soft);margin:0 0 10px;white-space:pre-wrap;line-height:1.5;">{b.contextText || '(no context)'}</pre>
                <button class="fh-btn fh-btn--ghost" data-admin="resolve-bug" data-bug-id={b.id} data-confirm={b.sheet_key ? 'Close this report? The attached sheet is deleted.' : undefined} style="font-size:11px;padding:5px 9px;">
                  {b.sheet_key ? 'close (deletes sheet)' : 'close'}
                </button>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="fh-mono" style="font-size:12.5px;color:var(--ink-faint);">
          {bugsMissing ? 'The bug_reports table is missing. Run npm run db:apply:remote.' : 'No open bug reports.'}
        </p>
      )}
    </section>
    <section class="fh-pad" style="padding:28px 0;border-bottom:1px solid var(--line);">
      <div class="fh-eyebrow" style="margin-bottom:14px;">Reports · {reports?.length ?? 0} open</div>
      {reports && reports.length > 0 ? (
        <div style="overflow-x:auto;">
          <table style="border-collapse:collapse;width:100%;min-width:680px;">
            <thead>
              <tr>
                <th style={th}>target</th>
                <th style={th}>reason</th>
                <th style={th}>reporter</th>
                <th style={th}>when</th>
                <th style={th}>actions</th>
              </tr>
            </thead>
            <tbody>
              {reports.map((r) => (
                <tr>
                  <td style={td}>
                    {r.target_type === 'maker' ? (
                      <span>
                        maker{' '}
                        {r.maker_handle ? (
                          <a href={`/u/${r.maker_handle}`} style="color:var(--ink);">@{r.maker_handle}</a>
                        ) : (
                          <span style="color:var(--ink-faint);">(gone)</span>
                        )}
                        {r.maker_banned ? <span class="fh-mono" style="color:var(--signal);font-size:11px;"> · banned</span> : null}
                      </span>
                    ) : (
                      <span>
                        font{' '}
                        {r.font_id ? (
                          <a href={`/f/${r.font_id}`} style="color:var(--ink);">{r.font_name ?? r.font_id}</a>
                        ) : (
                          <span style="color:var(--ink-faint);">(removed)</span>
                        )}
                      </span>
                    )}
                  </td>
                  <td style={`${td}max-width:280px;`}>{r.reason}</td>
                  <td style={td} class="fh-mono">{r.reporter_handle ?? r.reporter_email ?? '–'}</td>
                  <td style={td} class="fh-mono">{day(r.created_at)}</td>
                  <td style={td}>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                      {r.target_type === 'font' && r.font_id && (
                        <button class="fh-btn fh-btn--ghost" data-admin="remove-font" data-font-id={r.font_id} data-confirm="Remove this font for good?" style="font-size:11px;padding:5px 9px;">remove font</button>
                      )}
                      {r.target_type === 'maker' && r.reported_user_id && !r.maker_banned && (
                        <button class="fh-btn fh-btn--ghost" data-admin="ban" data-user-id={r.reported_user_id} data-confirm="Ban this maker (read-only)?" style="font-size:11px;padding:5px 9px;">ban maker</button>
                      )}
                      <button class="fh-btn fh-btn--ghost" data-admin="resolve" data-report-id={r.id} style="font-size:11px;padding:5px 9px;">dismiss</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="fh-mono" style="font-size:12.5px;color:var(--ink-faint);">No open reports.</p>
      )}
    </section>

    <section class="fh-pad" style="padding:28px 0 48px;">
      <div class="fh-eyebrow" style="margin-bottom:14px;">Users · {users?.length ?? 0}</div>
      <div style="overflow-x:auto;">
        <table style="border-collapse:collapse;width:100%;min-width:760px;">
          <thead>
            <tr>
              <th style={th}>name</th>
              <th style={th}>email</th>
              <th style={th}>handle</th>
              <th style={th}>joined</th>
              <th style={th}>fonts</th>
              <th style={th}>votes</th>
              <th style={th}>state</th>
              <th style={th}>action</th>
            </tr>
          </thead>
          <tbody>
            {(users ?? []).map((u) => (
              <tr>
                <td style={td}>{u.name}</td>
                <td style={td} class="fh-mono">{u.email}</td>
                <td style={td} class="fh-mono">{u.handle ? `@${u.handle}` : '–'}</td>
                <td style={td} class="fh-mono">{day(u.createdAt)}</td>
                <td style={td} class="fh-mono">{u.font_count}</td>
                <td style={td} class="fh-mono">{u.votes}</td>
                <td style={td} class="fh-mono">
                  {u.banned ? <span style="color:var(--signal);">banned</span> : <span style="color:var(--ink-faint);">active</span>}
                </td>
                <td style={td}>
                  {u.banned ? (
                    <button class="fh-btn fh-btn--ghost" data-admin="unban" data-user-id={u.id} style="font-size:11px;padding:5px 9px;">unban</button>
                  ) : (
                    <button class="fh-btn fh-btn--ghost" data-admin="ban" data-user-id={u.id} data-confirm="Ban this account (read-only)?" style="font-size:11px;padding:5px 9px;">ban</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script>
    import { actions } from 'astro:actions';
    const msg = document.getElementById('admin-msg');
    const say = (t: string) => {
      if (msg) msg.textContent = t;
    };
    document.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest('[data-admin]') as HTMLButtonElement | null;
      if (!b) return;
      const confirmMsg = b.dataset.confirm;
      if (confirmMsg && !confirm(confirmMsg)) return;
      b.disabled = true;
      say('working…');
      const kind = b.dataset.admin;
      let error = null;
      if (kind === 'ban') ({ error } = await actions.banUser({ userId: b.dataset.userId! }));
      else if (kind === 'unban') ({ error } = await actions.unbanUser({ userId: b.dataset.userId! }));
      else if (kind === 'resolve') ({ error } = await actions.resolveReport({ reportId: b.dataset.reportId! }));
      else if (kind === 'resolve-bug') ({ error } = await actions.resolveBugReport({ reportId: b.dataset.bugId! }));
      else if (kind === 'remove-font') ({ error } = await actions.removeFont({ fontId: b.dataset.fontId! }));
      else {
        b.disabled = false;
        return;
      }
      if (error) {
        b.disabled = false;
        say(error.message || 'that did not work');
        return;
      }
      location.reload();
    });
  </script>
</Base>
