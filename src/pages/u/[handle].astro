---
import Base from '../../layouts/Base.astro';
import FontCard from '../../components/FontCard.astro';
import { createAuth } from '../../lib/auth';
import { listFontsByOwner, getUserInteractions, fontFaceCss } from '../../lib/fonts';

export const prerender = false;

const { handle } = Astro.params;
const env = Astro.locals.runtime.env;

const maker = handle
  ? await env.DB.prepare('SELECT id, name, image, bio, updatedAt FROM "user" WHERE handle = ?')
      .bind(handle)
      .first<{ id: string; name: string; image: string | null; bio: string | null; updatedAt: string | null }>()
  : null;

if (!maker) {
  return Astro.rewrite('/404');
}

// owner viewing their own page sees private fonts too
const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });
const isOwner = session?.user.id === maker.id;

const fonts = await listFontsByOwner(env.DB, maker.id, isOwner);
const faceCss = fontFaceCss(fonts);
const inter = session
  ? await getUserInteractions(env.DB, session.user.id)
  : { voted: new Set<string>(), favorited: new Set<string>() };
const publicCount = fonts.filter((f) => f.visibility === 'public').length;
const privateCount = fonts.length - publicCount;
const makerDescription = `Fonts by ${handle} on fonthead.dev: ${publicCount} published ${publicCount === 1 ? 'font' : 'fonts'}. Browse and download them, or make your own.`;
const avatarUrl = maker.image ? `/cdn/${maker.image}?v=${maker.updatedAt ? Date.parse(maker.updatedAt) : ''}` : null;
const makerInitials = (maker.name || handle || '@')
  .split(/[\s@.]+/)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() ?? '')
  .join('');
---

<Base title={`@${handle} · fonthead.dev`} description={makerDescription} active="library">
  <style slot="head" is:inline set:html={faceCss}></style>

  <div style="background:var(--paper);min-height:100vh;">
    <header style="padding:48px 40px 28px;border-bottom:1px solid var(--line);">
      <p class="fh-eyebrow">maker</p>
      <div style="display:flex;align-items:center;gap:16px;margin:10px 0 0;">
        <div class="fh-avatar" style="width:56px;height:56px;font-size:18px;overflow:hidden;flex:none;">
          {avatarUrl ? (
            <img src={avatarUrl} alt="" style="width:100%;height:100%;object-fit:cover;" />
          ) : (
            <span>{makerInitials}</span>
          )}
        </div>
        <div>
          <h1 class="fh-mono" style="font-size:30px;font-weight:700;letter-spacing:-.01em;margin:0;">@{handle}</h1>
          <p class="fh-mono" style="font-size:12px;color:var(--ink-faint);margin:4px 0 0;">
            {maker.name} · {publicCount} public{isOwner && privateCount > 0 ? ` · ${privateCount} private` : ''}
          </p>
        </div>
      </div>
      {maker.bio && (
        <p style="font-size:14px;color:var(--ink-soft);line-height:1.6;margin:16px 0 0;max-width:62ch;">{maker.bio}</p>
      )}
    </header>

    {fonts.length > 0 ? (
      <div style="padding:28px 40px 40px;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:20px;">
        {fonts.map((f) => <FontCard font={f} voted={inter.voted.has(f.id)} favorited={inter.favorited.has(f.id)} />)}
      </div>
    ) : (
      <p class="fh-mono" style="padding:40px;font-size:13px;color:var(--ink-faint);">
        Nothing published yet.
      </p>
    )}

    <footer class="fh-pad" style="padding:26px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      <div class="fh-mono" style="font-size:11px;color:var(--ink-faint);"><a href="/" style="color:inherit;text-decoration:none;">&larr; the library</a></div>
      {session && !isOwner && (
        <button data-report data-report-target="maker" data-report-id={handle} class="fh-mono" style="background:none;border:none;cursor:pointer;font-size:11px;color:var(--ink-faint);padding:0;text-decoration:underline;text-underline-offset:3px;">report this maker</button>
      )}
    </footer>
  </div>
</Base>
