---
import { type Font, specClass, specTreat, familyOf, specimenFontSize } from '../lib/fonts';

// A second composition break: one font set as a full-width living specimen
// dropped into the wall, re-asserting the type-first hierarchy mid-scroll so
// the grid stops reading as a single uniform module. Spans every grid column.
interface Props {
  font: Font;
  label?: string;
}
const { font: f, label = 'in color' } = Astro.props;
const m = f.meta;
---

<div class="fh-wide">
  <div class="fh-eyebrow fh-wide-label">{label}</div>
  <div
    class={specClass(m)}
    data-typeinto
    data-fit-max="240"
    data-fit-fluid="19"
    data-fit-unit="vw"
    contenteditable="true"
    spellcheck="false"
    role="textbox"
    aria-multiline="false"
    aria-label={`Type to preview ${f.name}`}
    style={`font-family:'${familyOf(f.id)}',var(--sans);${specTreat(m)};font-size:${specimenFontSize(f.specimen_word, 240, 19, 'vw')};line-height:.86;white-space:normal;overflow-wrap:anywhere;max-width:100%;caret-color:var(--signal);cursor:text;`}
  >
    {f.specimen_word}
  </div>
  <a href={`/f/${f.id}`} class="fh-mono fh-wide-credit">{f.name} · by {f.maker_handle}&nbsp;&nbsp;&rarr;</a>
</div>
