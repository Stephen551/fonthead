---
// Quiet mono chrome. Auth state comes from the layout: an avatar linking to
// the account when signed in, a sign-in link otherwise.
interface Props {
  active?: 'library' | 'make';
  user?: { name: string } | null;
}
const { active = 'library', user = null } = Astro.props;
const initials = user
  ? user.name
      .split(/[\s@.]+/)
      .slice(0, 2)
      .map((s) => s[0]?.toUpperCase() ?? '')
      .join('')
  : '';
---

<nav class="fh-nav">
  <a href="/" class="fh-wordmark">fonthead<span class="dot">.dev</span></a>
  <div class="fh-nav-secondary" style="display:contents">
    <div class="fh-nav-div"></div>
    <a href="/" class="fh-navlink" style={active === 'library' ? 'color:var(--ink);font-weight:600;' : undefined}>library</a>
    <a href="/make" data-astro-reload class="fh-navlink" style={active === 'make' ? 'color:var(--ink);font-weight:600;' : undefined}>make</a>
    <a href="/faq" class="fh-navlink">faq</a>
  </div>
  <div class="fh-nav-spacer"></div>
  <a href="/make" data-astro-reload class="fh-btn">make a font&nbsp;&nbsp;&rarr;</a>
  {
    user ? (
      <a href="/account" class="fh-avatar" title={user.name}>{initials}</a>
    ) : (
      <>
        <a href="/sign-in" class="fh-navlink">sign in</a>
        <a href="/sign-up" class="fh-navlink">sign up</a>
      </>
    )
  }
</nav>
