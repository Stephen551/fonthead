---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'fonthead.dev',
  description = 'A community font library and maker. Turn an alphabet sheet into a real font, publish it, browse what everyone makes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
