---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import FHNav from '../components/FHNav.astro';
import { createAuth } from '../lib/auth';
import { escapeJsonForScript } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  active?: 'library' | 'make';
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'fonthead.dev',
  description = 'A community font library and maker. Turn an alphabet sheet into a real font, publish it, browse what everyone makes.',
  active = 'library',
  ogImage = '/og.png',
  schema,
} = Astro.props;

// Absolute URLs for canonical + social cards, from the request origin.
const canonical = Astro.url.href;
const origin = Astro.url.origin;
const ogImageAbs = new URL(ogImage, origin).href;

// Site-wide structured data: the site itself, its search action, and the
// publisher. Per-page schema (e.g. a font's CreativeWork) is passed in via the
// schema prop. Both are escaped before set:html — a font name in the per-page
// schema is user-controlled (see escapeJsonForScript / the hero data island).
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'fonthead.dev',
      url: origin + '/',
      description: 'A community font library and maker.',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: origin + '/?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
    { '@type': 'Organization', name: 'fonthead.dev', url: origin + '/' },
  ],
};

// Auth state for the nav. getSession returns null cheaply when there is no
// session cookie, so anonymous page loads do not hit the database.
let navUser: { name: string } | null = null;
try {
  const auth = createAuth(Astro.locals.runtime.env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session) navUser = { name: session.user.name };
} catch {
  /* nav stays anonymous on any auth error */
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fonthead.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <script type="application/ld+json" is:inline set:html={escapeJsonForScript(JSON.stringify(siteLd))} />
    {schema && <script type="application/ld+json" is:inline set:html={escapeJsonForScript(JSON.stringify(schema))} />}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body data-signed-in={navUser ? 'true' : 'false'}>
    <a href="#main" class="skip-link">Skip to content</a>
    <FHNav active={active} user={navUser} />
    <main id="main">
      <slot />
    </main>
    {/* polite live region for transient status (vote/favourite/report results) */}
    <div id="fh-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
