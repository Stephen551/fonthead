---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import FHNav from '../components/FHNav.astro';
import { createAuth } from '../lib/auth';
import { escapeJsonForScript, isAdminEmail } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  active?: 'library' | 'make';
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  // override the self-referential canonical (used to collapse home facets like
  // ?sort / ?page / ?q onto the clean home URL) and set a robots directive
  // (e.g. noindex,follow on thin search-result pages).
  canonical?: string;
  robots?: string;
}

const {
  title = 'fonthead.dev',
  description = 'A community font library and maker. Turn an alphabet sheet into a real font, publish it, browse what everyone makes.',
  active = 'library',
  ogImage = '/og.png',
  schema,
  canonical: canonicalProp,
  robots,
} = Astro.props;

// Absolute URLs for canonical + social cards, from the request origin.
const canonical = canonicalProp ?? Astro.url.href;
const origin = Astro.url.origin;
const ogImageAbs = new URL(ogImage, origin).href;

// Site-wide structured data: the site itself, its search action, and the
// publisher. Per-page schema (e.g. a font's CreativeWork) is passed in via the
// schema prop. Both are escaped before set:html — a font name in the per-page
// schema is user-controlled (see escapeJsonForScript / the hero data island).
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'fonthead.dev',
      url: origin + '/',
      description: 'A community font library and maker.',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: origin + '/?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'fonthead.dev',
      url: origin + '/',
      logo: origin + '/og.png',
      description: 'A community font library and maker. Trace an alphabet sheet into a real, installable font in your browser.',
      sameAs: ['https://github.com/Stephen551/fonthead'],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'support@fonthead.dev',
        contactType: 'customer support',
      },
    },
  ],
};

// Auth state for the nav. getSession returns null cheaply when there is no
// session cookie, so anonymous page loads do not hit the database.
let navUser: { name: string } | null = null;
let navAdmin = false;
try {
  const env = Astro.locals.runtime.env;
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session) {
    navUser = { name: session.user.name };
    navAdmin = isAdminEmail(env.ADMIN_EMAILS, session.user.email);
  }
} catch {
  /* nav stays anonymous on any auth error */
}

// Support nudge. Set COFFEE_URL to a real Buy Me a Coffee / Ko-fi / Sponsors link
// to switch it on; left empty it renders nothing, so the feature ships dormant
// until the link exists. app.ts shows the card once per session after a font is
// made or downloaded.
const COFFEE_URL = 'https://buymeacoffee.com/fonthead';
const coffeeOn = COFFEE_URL.startsWith('https://');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Resolve the theme before first paint: the saved choice wins, else the
        OS preference. ClientRouter swaps <html> attributes on navigation, so
        re-apply after every swap; follow OS changes only while unset. */}
    <script is:inline>
      (() => {
        const apply = () => {
          let t = null;
          try {
            t = localStorage.getItem('fh-theme');
          } catch {
            /* private mode */
          }
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          let t = null;
          try {
            t = localStorage.getItem('fh-theme');
          } catch {
            /* private mode */
          }
          if (t !== 'light' && t !== 'dark') apply();
        });
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fonthead.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <script type="application/ld+json" is:inline set:html={escapeJsonForScript(JSON.stringify(siteLd))} />
    {schema && <script type="application/ld+json" is:inline set:html={escapeJsonForScript(JSON.stringify(schema))} />}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body data-signed-in={navUser ? 'true' : 'false'}>
    <a href="#main" class="skip-link">Skip to content</a>
    <FHNav active={active} user={navUser} isAdmin={navAdmin} />
    <main id="main">
      <slot />
    </main>
    {/* polite live region for transient status (vote/favorite/report results) */}
    <div id="fh-status" class="sr-only" role="status" aria-live="polite"></div>
    {coffeeOn && (
      <div id="fh-coffee" class="fh-coffee" hidden role="complementary" aria-label="Support fonthead">
        <button id="fh-coffee-x" class="fh-coffee-x" type="button" aria-label="Dismiss">&times;</button>
        <p class="fh-coffee-msg">fonthead is free to use. if it saved you some time, a coffee helps me keep building it.</p>
        <a id="fh-coffee-link" class="fh-btn" href={COFFEE_URL} target="_blank" rel="noopener noreferrer">buy me a coffee</a>
      </div>
    )}
    {/* shared report dialog: opened from a font page or a maker profile via a
        [data-report] trigger. Hidden until then; app.ts manages focus + submit. */}
    <div id="fh-report" class="fh-tour" hidden role="dialog" aria-modal="true" aria-label="Report">
      <div class="fh-tour-card">
        <button id="fh-report-x" type="button" class="fh-tour-x" aria-label="Close">&times;</button>
        <p class="fh-eyebrow" id="fh-report-eyebrow">report</p>
        <h2 class="fh-tour-title" style="font-size:16px;margin:8px 0 12px;">What looks wrong?</h2>
        <textarea id="fh-report-text" class="fh-input" rows="3" maxlength="300" placeholder="a short reason helps" style="width:100%;resize:vertical;font-family:var(--sans);"></textarea>
        <p id="fh-report-msg" role="status" aria-live="polite" class="fh-mono" style="font-size:11.5px;color:var(--ink-soft);min-height:14px;margin:8px 0 0;"></p>
        <div class="fh-tour-actions" style="margin-top:12px;">
          <button id="fh-report-send" type="button" class="fh-btn">send report</button>
          <button id="fh-report-cancel" type="button" class="fh-btn fh-btn--ghost">cancel</button>
        </div>
      </div>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
