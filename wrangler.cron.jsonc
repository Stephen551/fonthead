{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fonthead-cron",
  "main": "cron/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fonthead",
      "database_id": "f4991cba-1ebf-4d91-8d91-bca4eadb3ad8"
    }
  ]
}
